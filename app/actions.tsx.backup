// 代理初始化函数
function initializeProxy() {
  if (typeof window === 'undefined') {
    console.log('🔧 Setting up proxy for AI SDK...');
    
    // 设置基本环境变量
    process.env.HTTP_PROXY = 'http://127.0.0.1:7890';
    process.env.HTTPS_PROXY = 'http://127.0.0.1:7890';
    process.env.NO_PROXY = 'localhost,127.0.0.1';
    process.env.GLOBAL_AGENT_HTTP_PROXY = 'http://127.0.0.1:7890';
    process.env.GLOBAL_AGENT_HTTPS_PROXY = 'http://127.0.0.1:7890';
    process.env.GLOBAL_AGENT_NO_PROXY = 'localhost,127.0.0.1';
    
    console.log('✅ Proxy environment variables set');
    
    // 尝试启用 global-agent
    try {
      const globalAgent = require('global-agent');
      globalAgent.bootstrap();
      console.log('✅ Global-agent proxy enabled');
    } catch (error: any) {
      console.log('⚠️ Global-agent not available:', error.message);
    }
    
    // 设置 DNS 优先级
    try {
      const dns = require('dns');
      dns.setDefaultResultOrder('ipv4first');
      console.log('✅ DNS set to prefer IPv4');
    } catch (error: any) {
      console.log('⚠️ DNS configuration failed:', error.message);
    }
    
    const proxyUrl = process.env.HTTPS_PROXY || process.env.HTTP_PROXY;
    
    if (proxyUrl) {
      console.log('🌐 Configuring undici proxy for Google API:', proxyUrl);
      
      try {
        const { ProxyAgent } = require('undici');
        const proxyAgent = new ProxyAgent(proxyUrl);
        
        // 保存原始的 fetch
        const originalFetch = globalThis.fetch;
        
        // 重写 fetch 函数使用 undici ProxyAgent
        globalThis.fetch = (url: RequestInfo | URL, options: RequestInit = {}) => {
          const urlString = typeof url === 'string' ? url : url.toString();
          
          // 只对 Google API 请求使用代理
          if (urlString.includes('generativelanguage.googleapis.com') || 
              urlString.includes('googleapis.com')) {
            
            console.log('🔄 Using proxy for Google API request:', urlString);
            
            // 使用 undici 的 fetch 和 ProxyAgent
            const { fetch: undiciFetch } = require('undici');
            
            return undiciFetch(url, {
              ...options,
              dispatcher: proxyAgent,
              // 移除可能不兼容的 AbortSignal.timeout
              signal: options.signal
            });
          }
          
          // 其他请求使用原始 fetch
          return originalFetch(url, options);
        };
        
        console.log('✅ AI SDK proxy setup completed');
        
      } catch (error) {
        console.error('❌ Failed to setup AI SDK proxy:', error);
      }
    } else {
      console.log('📡 No proxy configured for AI SDK');
    }
    
    // 设置 DNS 优先使用 IPv4
    try {
      const dns = require('dns');
      dns.setDefaultResultOrder('ipv4first');
      console.log('✅ DNS set to prefer IPv4 for AI SDK');
    } catch (error) {
      console.error('❌ Failed to set IPv4 preference:', error);
    }
  }
}

// 调用代理初始化
initializeProxy();

// DeepSeek 配置
